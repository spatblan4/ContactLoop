# FastAPI backend configuration.
# Priority for the database connection:
#   1. SUPABASE_DB_URL (full Postgres DSN, e.g. postgresql+psycopg://user:password@host:5432/contactloop)
#   2. DATABASE_URL (generic override)
#   3. SQLite fallback at SQLITE_PATH
SUPABASE_DB_URL=
DATABASE_URL=
SQLITE_PATH=./data/contactloop.db

# Optional Supabase JWT secret
SUPABASE_JWT_SECRET=

# Comma-separated CORS origins (default: *)
CORS_ORIGINS=*

APP_ENV=development
