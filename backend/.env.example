# FastAPI database configuration. Keep real values only in backend/.env.
SUPABASE_DB_URL=
DATABASE_URL=
SQLITE_PATH=./data/contactloop.db

# Authentication and server-side Supabase access.
SUPABASE_URL=
SUPABASE_SECRET_KEY=

# Existing Contact Brief Lambda endpoint. Never expose this as a VITE_* variable.
CONTACT_BRIEF_ENDPOINT=
CONTACT_BRIEF_TIMEOUT_SECONDS=60
SUPABASE_FUNCTION_TIMEOUT_SECONDS=15

# Local Strands Outreach Agent on Amazon Bedrock.
# AWS_REGION is required when BEDROCK_MODEL_ID is set.
AWS_REGION=
BEDROCK_MODEL_ID=
BEDROCK_TEMPERATURE=0.2
OUTREACH_AGENT_TIMEOUT_SECONDS=90

# Voice-note storage and upload limit (25 MB by default).
VOICE_NOTES_DIR=
VOICE_MAX_UPLOAD_BYTES=26214400

# Comma-separated browser origins allowed to call FastAPI.
CORS_ORIGINS=http://127.0.0.1:5173
APP_ENV=development
