# FastAPI database configuration. Keep real values only in backend/.env.
SUPABASE_DB_URL=
DATABASE_URL=
SQLITE_PATH=./data/contactloop.db

# Authentication and server-side Supabase access.
SUPABASE_URL=
SUPABASE_SECRET_KEY=

# Existing Contact Brief Lambda endpoint. Never expose this as a VITE_* variable.
CONTACT_BRIEF_ENDPOINT=
CONTACT_BRIEF_TIMEOUT_SECONDS=60
SUPABASE_FUNCTION_TIMEOUT_SECONDS=15

# Local Strands Outreach Agent on Amazon Bedrock.
# AWS_REGION is required when BEDROCK_MODEL_ID is set.
AWS_REGION=
BEDROCK_MODEL_ID=
BEDROCK_TEMPERATURE=0.2
OUTREACH_AGENT_TIMEOUT_SECONDS=90

# Optional Bedrock Guardrails applied to the Outreach Agent.
BEDROCK_GUARDRAIL_ID=
BEDROCK_GUARDRAIL_VERSION=
# Redact guarded content (student PII) from agent replies.
BEDROCK_GUARDRAIL_REDACT_OUTPUT=false

# Run call-summary drafts through the draft -> judge -> finalize
# Strands Graph quality pipeline instead of a single agent call.
CALL_SUMMARY_QUALITY_PIPELINE=false
# Node-execution cap for that pipeline (bounds the judge revise loop).
SUMMARY_PIPELINE_MAX_NODE_EXECUTIONS=6

# Messages kept in memory per teacher agent conversation before summarizing.
AGENT_PRESERVE_RECENT_MESSAGES=10

# Optional read-only MCP server (e.g. a school calendar). The outreach QA
# agent only sees the tools named in MCP_ALLOWED_TOOLS; leave the URL empty
# to disable. Requires backend/requirements-bedrock.txt.
MCP_SERVER_URL=
MCP_ALLOWED_TOOLS=

# Optional Strands agent tracing. OTLP export also honors the standard
# OTEL_EXPORTER_OTLP_ENDPOINT / OTEL_SERVICE_NAME variables and requires
# backend/requirements-bedrock.txt.
STRANDS_CONSOLE_TRACING=false
STRANDS_OTLP_TRACING=false

# Voice-note storage and upload limit (25 MB by default).
VOICE_NOTES_DIR=
VOICE_MAX_UPLOAD_BYTES=26214400

# Voice-note transcription via Amazon Transcribe (requires AWS credentials).
# When enabled, completed transcriptions create unconfirmed teacher-note drafts.
VOICE_TRANSCRIBE_ENABLED=false
VOICE_TRANSCRIBE_BUCKET=
VOICE_TRANSCRIBE_LANGUAGE=en-US

# Comma-separated browser origins allowed to call FastAPI.
CORS_ORIGINS=http://127.0.0.1:5173
APP_ENV=development
