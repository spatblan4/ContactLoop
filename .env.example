# FastAPI backend base URL used by the fetch-based API client (src/lib/api/)
VITE_API_BASE_URL=http://localhost:8000
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key
VITE_APP_MODE=demo
VITE_TELEPHONY_PROVIDER=mock
VITE_CONTACT_BRIEF_PROVIDER=none
VITE_AWS_CONTACT_BRIEF_ENDPOINT=

# Server-only Supabase Edge Function secrets (never add these to VITE_* vars)
# GCP_PROJECT_ID=
# GCP_SERVICE_ACCOUNT_EMAIL=
# GCP_SERVICE_ACCOUNT_PRIVATE_KEY=-----BEGIN PRIVATE KEY-----\\n...\\n-----END PRIVATE KEY-----\\n
# GCS_VOICE_BUCKET=
